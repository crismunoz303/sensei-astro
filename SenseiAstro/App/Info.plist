<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>$(DEVELOPMENT_LANGUAGE)</string>
  <key>CFBundleDisplayName</key>
  <string>Sensei Astro</string>
  <key>CFBundleIconName</key>
  <string>AppIcon</string>
  <key>CFBundleIconFiles</key>
  <array>
    <string>AppIcon</string>
  </array>
  <key>CFBundleIcons</key>
  <dict>
    <key>CFBundlePrimaryIcon</key>
    <dict>
      <key>CFBundleIconFiles</key>
      <array>
        <string>AppIcon</string>
      </array>
      <key>CFBundleIconName</key>
      <string>AppIcon</string>
    </dict>
  </dict>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key>
  <string>$(CURRENT_PROJECT_VERSION)</string>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.sensei.astro</string>
      <key>CFBundleURLSchemes</key>
      <array><string>senseiastro</string></array>
    </dict>
  </array>
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>Sensei Astro uses your location while open for targets, Sun and Moon times, weather, and cloud maps. Coordinates are sent to forecast and map providers to show your local sky.</string>
  <key>NSPhotoLibraryAddUsageDescription</key>
  <string>Sensei Astro saves finished copies while always preserving your original photograph.</string>
  <key>LSRequiresIPhoneOS</key>
  <true/>
  <key>UILaunchScreen</key>
  <dict/>
  <key>UIUserInterfaceStyle</key>
  <string>Dark</string>
</dict>
</plist>
